# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API).

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Service-role key. Server-side only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Timezone used for the 06:00 business-day boundary. Defaults to
# Europe/Amsterdam. Must be the same value the browser uses, so it is public.
NEXT_PUBLIC_APP_TIMEZONE=Europe/Amsterdam
